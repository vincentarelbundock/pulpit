{
  "format_version": 1,
  "name": "Slide + Notes Beside",
  "design_ratio": "sixteen-nine",
  "root": {
    "type": "split",
    "id": 0,
    "name": "Presenter screen",
    "direction": "horizontal",
    "children": [
      {
        "type": "leaf",
        "id": 1,
        "widget": {
          "kind": "current-slide",
          "style": {
            "variant": "standard",
            "scale": 1.0,
            "alignment": "center"
          },
          "config": {
            "slide": {
              "fit": "fit"
            }
          }
        },
        "padding": 0.0,
        "background": "none",
        "border": "none",
        "empty_behavior": "show-blank-panel"
      },
      {
        "type": "split",
        "id": 2,
        "name": "Notes rail",
        "direction": "vertical",
        "children": [
          {
            "type": "leaf",
            "id": 3,
            "widget": {
              "kind": "speaker-notes",
              "style": {
                "variant": "standard",
                "scale": 1.0,
                "alignment": "center"
              },
              "config": {
                "notes": {
                  "font_size": 18.0,
                  "line_spacing": 1.5,
                  "source": "current-slide"
                }
              }
            },
            "padding": 12.0,
            "background": "panel",
            "border": "none",
            "empty_behavior": "show-blank-panel"
          },
          {
            "type": "leaf",
            "id": 4,
            "widget": {
              "kind": "slide-slider",
              "style": {
                "variant": "standard",
                "scale": 1.0,
                "alignment": "center"
              },
              "config": "none"
            },
            "padding": 12.0,
            "background": "panel",
            "border": "none",
            "empty_behavior": "show-blank-panel"
          },
          {
            "type": "leaf",
            "id": 5,
            "widget": {
              "kind": "slide-buttons",
              "style": {
                "variant": "standard",
                "scale": 1.0,
                "alignment": "center"
              },
              "config": {
                "buttons": {
                  "back": true,
                  "forward": true,
                  "labels": true
                }
              }
            },
            "padding": 12.0,
            "background": "panel",
            "border": "none",
            "empty_behavior": "show-blank-panel"
          }
        ],
        "sizes": [
          0.77,
          0.07,
          0.16
        ],
        "gap": 8.0,
        "min_child": 0.05
      }
    ],
    "sizes": [
      0.75,
      0.25
    ],
    "gap": 8.0,
    "min_child": 0.05
  }
}